# === NEVER commit copyrighted game content or debug symbols ===
/dumps/
/game/
*.pak
*.ucas
*.utoc
*.pdb
*.exe
*.dll
*.so
UE4SS*.log
ue4ss.log

# Build / release output
/dist/
/build/
*.zip

# The one binary the repo ships on purpose: the trimmed, runtime-only UE4SS payload
# (built by tools/make_ue4ss_runtime.py; players download nothing from the internet).
!/vendor/UE4SS-Solarpunk-runtime.zip

# Cooked assets staging (source .uasset live in a separate art repo, not here)
/paks/**/*.uasset
/paks/**/*.umap

# Game-derived mapping dump. Can only be produced from the RUNNING game (the mod's exec channel
# calls DumpUSMAP), so it is worth keeping locally -- but it is the game's data, not ours.
*.usmap

# Same rule, same reason: a UAssetAPI dump of the game's DB_Items DataTable. Worth keeping
# locally (tools/pakkit/gen_nonstackables.py --allow-vanilla reads it when no staged build is
# around) but it is 3 MB of the game's data. tools/pakkit/.gitignore already excludes it there;
# putting a copy under vendor/ was a way around our own rule, not an exception to it.
db_items.json

# The live exec channel + RE scratch (cmd.txt/result.txt, save backups): runtime game data,
# machine-local by nature
/dump/

# Python tooling cruft
__pycache__/
*.pyc
/tools/.gamedir

# Editor / OS cruft
.vscode/
.idea/
*.tmp
*.bak
Thumbs.db
.DS_Store

# scratch dir the poison-latch spec creates
tests/.tmp_latch/
